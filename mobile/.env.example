# Includes /api; use your computer's LAN IP for a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# Development builds only; set 0 for preview/production and use HTTPS.
ACB_ALLOW_HTTP=1
# Public Expo/EAS project UUID, NOT a secret.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional, after native Google credentials have been configured.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APP_LINK_HOST=
# Android Firebase client configuration file path, also supported as an EAS file environment variable.
GOOGLE_SERVICES_JSON=
