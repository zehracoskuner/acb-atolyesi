# Replace placeholders through your local environment or secret manager.
JWT_SECRET=<your-random-jwt-secret>
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=<your-google-callback-url>
ADMIN_SECRET_PATH=<your-admin-route>
MONGO_URI=<your-mongodb-uri>
CLIENT_URL=<your-client-url>
SITE_URL=<your-site-url>
API_URL=<your-https-backend-api-url>
CLOUDINARY_CLOUD_NAME=<your-cloudinary-name>
CLOUDINARY_API_KEY=<your-cloudinary-key>
CLOUDINARY_API_SECRET=<your-cloudinary-secret>
RESEND_API_KEY=<your-resend-key>
EMAIL_FROM=<your-verified-sender-address>

# Writer development coach: enable only in the intended deployment.
DEVELOPMENT_COACH_ENABLED=false
DEVELOPMENT_COACH_PROVIDER=openai
DEVELOPMENT_COACH_MODEL=gpt-6-luna
DEVELOPMENT_ANALYSIS_DAILY_LIMIT=2
DEVELOPMENT_ANALYSIS_TIMEOUT_MS=90000
# Development Coach: OPENAI_API_KEY; fixed low reasoning, store=false, no fallback.
# OPENAI_API_KEY=<your-openai-api-key>
# Explicitly selecting provider=gemini requires a Gemini model and GEMINI_API_KEY.
# GEMINI_MODEL remains independent for Character Arc AI.

# Gmail sender (requires a Google App Password; never use your account password).
EMAIL_PROVIDER=gmail
GMAIL_USER=acbatolyesi@gmail.com
GMAIL_APP_PASSWORD=<your-google-app-password>
EMAIL_REPLY_TO=acbatolyesi@gmail.com
# EMAIL_PROVIDER=resend uses RESEND_API_KEY and a verified EMAIL_FROM instead.
