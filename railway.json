{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "railpackVersion": "0.40.1",
    "watchPatterns": [
      "/backend/**",
      "/shared/**",
      "/railway.json",
      "/railpack.json",
      "/package.json",
      "/package-lock.json",
      "/scripts/check-backend-release.mjs"
    ]
  },
  "deploy": {
    "startCommand": "node backend/server.js",
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 300,
    "drainingSeconds": 20
  }
}
